# Copy to .env locally. Never commit a real credential.
# Optional path to a private JSON service profile outside this repository.
# Explicit environment and nonempty .env settings take precedence over profile values.
CUA_JEV_SERVICE_PROFILE=
TYPESAFE_API_KEY=
CUA_JEV_MODEL=jev-1.13.0
CUA_JEV_API_URL=https://api.typesafe.ai/v1/systemone
# OpenAI-compatible planner/VLM service. These are loaded from local .env.
CUA_JEV_PLANNER_API_KEY=
CUA_JEV_MODEL_API_KEY=
CUA_JEV_MODEL_BASE_URL=
CUA_JEV_VLM_MODEL=
